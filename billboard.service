[Unit]
Description=Stock Price Billboard Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/Billboard
ExecStart=/home/%i/Billboard/venv/bin/python /home/%i/Billboard/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# --- Install instructions (run on the Raspberry Pi) ---
# 1. Copy this project (including venv/, or recreate the venv on the Pi) to /home/<user>/Billboard
# 2. Copy this file as a per-user instance unit:
#      sudo cp billboard.service /etc/systemd/system/billboard@.service
# 3. Reload and enable, substituting your actual username for <user>:
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now billboard@<user>.service
# 4. Check status / logs:
#      systemctl status billboard@<user>.service
#      journalctl -u billboard@<user>.service -f
